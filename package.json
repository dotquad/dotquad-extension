{
  "name": "dotquad-extension",
  "version": "0.1.2",
  "private": true,
  "description": "Dotquad for Chrome, Edge and Firefox: grade the site you're on, check links before you click them, look up any IP or domain, and see your own IP and VPN status.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "BinaryNoir Studios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotquad/dotquad-extension.git"
  },
  "homepage": "https://dotquad.app/apps/",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dotquad/net": "^0.1.0",
    "@dotquad/tokens": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=22"
  }
}
